# Copy to .env and fill in ONE of these. .env is gitignored; .env.example is not.
# Mentor uses this only to plan steps. Pixels never leave the machine --
# only element labels, your goal, and the application name.
# A real environment variable always wins over this file.

# Option A -- Anthropic directly (--provider anthropic, the default)
ANTHROPIC_API_KEY=sk-ant-...

# Option B -- OpenRouter (--provider openrouter). One key reaches both the
# free models and anthropic/claude-opus-5 at the same price as going direct.
# OPENROUTER_API_KEY=sk-or-...
